# Variables de docker compose. Copiar como ".env" en ESTA carpeta:
#
#   cp .env.example .env
#
# El .env real esta en .gitignore: NUNCA lo subas al repositorio.
# (No confundir con backend/.env.example, que es para correr los servicios con
# Gradle directamente en el host, sin contenedores.)

# --- Secreto compartido de los JWT (OBLIGATORIO) ---------------------------
# Minimo 32 caracteres. Debe ser el mismo para todos los servicios: auth-service
# firma los tokens y los demas los validan. Generar uno:
#
#   openssl rand -hex 32
#
JWT_SECRET=
JWT_ISSUER=goslint-judge

# --- Super administrador inicial -------------------------------------------
# Se crea al arrancar auth-service si todavia no existe ninguno. Es la unica forma
# de obtener ese rol. La contrasena: minimo 8 caracteres, con una mayuscula, un
# numero y un caracter especial. Sin estas dos variables no se crea.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_USERNAME=superadmin

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=goslint_judge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379

# --- Puertos publicados en tu maquina --------------------------------------
# Cambialos si ya tienes algo ocupando ese puerto (p. ej. un PostgreSQL local en 5432).
AUTH_PORT=8081
PROBLEM_PORT=8082
SUBMISSION_PORT=8083

# --- Frontend --------------------------------------------------------------
# Origenes del navegador autorizados por CORS (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- judge-service (solo con --profile sandbox, en Linux) ------------------
# JUDGE_PORT=8084
# JUDGE_WORKERS=2
# JUDGE_SANDBOX_LOG_LEVEL=INFO
