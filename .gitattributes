# Finales de línea. Lo que se ejecuta dentro de Linux (contenedores) debe ir
# siempre con LF, aunque el checkout se haga en Windows con core.autocrlf=true:
# con CRLF, "./gradlew" y los .sh fallan con "bad interpreter: /bin/sh^M".
* text=auto

*.sh        text eol=lf
*.py        text eol=lf
gradlew     text eol=lf
Dockerfile* text eol=lf
*.Dockerfile text eol=lf
*.slice     text eol=lf

*.bat       text eol=crlf
