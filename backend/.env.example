# Ejemplo de variables de entorno (Copiar como .env)
# IMPORTANTE: ¡Nunca subas el archivo .env real al repositorio de Git!

# Base de Datos
# El nombre de la BD debe coincidir con POSTGRES_DB de
# infrastructure/docker/docker-compose.yml: es ahi donde Flyway aplica las
# migraciones de cada servicio al arrancar.
DB_URL=jdbc:postgresql://localhost:5432/goslint_judge_db
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_aqui

# Mensajería (RabbitMQ)
# Debe coincidir con lo definido en infrastructure/docker/docker-compose.yml
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
