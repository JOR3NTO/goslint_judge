# Modo demo (mock): copia este archivo a `.env.local` (ignorado por git) para activarlo.
# Con NEXT_PUBLIC_USE_MOCK=true la app responde con datos simulados en el navegador y
# no necesita backend ni base de datos. Se ignora en producción (next build / next start).
# Detalles, credenciales demo y límites: frontend/README.md, sección "Modo demo (mock)".
NEXT_PUBLIC_USE_MOCK=true

# Backend real (solo se usa con NEXT_PUBLIC_USE_MOCK=false):
# NEXT_PUBLIC_API_BASE_URL=/api
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# URL de la landing pública (logo del navbar/footer y redirect de "/"). Por defecto http://localhost:3002
# NEXT_PUBLIC_LANDING_URL=http://localhost:3002
