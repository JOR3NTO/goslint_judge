{
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:landing": "pnpm --filter @uceva-judge/landing-app dev",
    "dev:student": "pnpm --filter @uceva-judge/student-app dev",
    "dev:admin": "pnpm --filter @uceva-judge/admin-app dev",
    "build": "pnpm -r build",
    "build:landing": "pnpm --filter @uceva-judge/landing-app build",
    "build:student": "pnpm --filter @uceva-judge/student-app build"
  }
}
